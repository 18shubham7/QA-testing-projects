    {
      "name": "Jobs",
      "item": [
        {
          "name": "Add Job",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/api/jobs/addjob",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyName\": \"Google\",\n  \"jobRole\": \"React Developer\",\n  \"jobLocation\": \"Mumbai\",\n  \"applicationStatus\": \"applied\",\n  \"applicationDate\": \"2026-06-27\",\n  \"notes\": \"Applied via LinkedIn\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200 or 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "pm.test(\"Job ID exists in response\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json._id || json.job?._id).to.not.be.undefined;",
                  "    const id = json._id || json.job?._id;",
                  "    pm.collectionVariables.set(\"jobId\", id);",
                  "});",
                  "",
                  "pm.test(\"Success message received\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.not.be.undefined;",
                  "});"
                ]
              }
            }
          ]
